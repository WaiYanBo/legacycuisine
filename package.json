{
  "name": "grabfood-reconciliation-api",
  "version": "1.0.0",
  "description": "Enterprise food delivery aggregator reconciliation backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:frontend": "next dev -p 3001",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@libsql/client": "^0.14.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "puppeteer": "^22.12.0",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "concurrently": "^8.2.2",
    "tailwindcss": "^3.4.3",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19"
  }
}
