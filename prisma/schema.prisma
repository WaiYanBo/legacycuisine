// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Merchant represents the local restaurant owner/seller.
model Merchant {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  businessName String         @map("business_name")
  contactEmail String         @map("contact_email")
  contactPhone String?        @map("contact_phone")
  status       MerchantStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  storefronts Storefront[]
  invoices    Invoice[]

  @@index([status])
  @@map("merchants")
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Storefront represents the Grab Account link mapping to a unique Grab email/domain.
model Storefront {
  id        String   @id @default(uuid()) @db.Uuid
  merchantId String  @map("merchant_id") @db.Uuid
  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  grabEmail String   @unique @map("grab_email")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productMasters ProductMaster[]
  grabOrders     GrabOrder[]

  @@index([merchantId])
  @@map("storefronts")
}

/// ProductMaster serves as the Price Ledger, storing base prices and expected grab prices.
model ProductMaster {
  id                  String   @id @default(uuid()) @db.Uuid
  storefrontId        String   @map("storefront_id") @db.Uuid
  storefront          Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  sku                 String
  name                String
  restaurantBasePrice Decimal  @map("restaurant_base_price") @db.Decimal(12, 2)
  grabExpectedPrice   Decimal? @map("grab_expected_price") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  orderLineItems      OrderLineItem[]
  needsReview         Boolean @default(false) @map("needs_review")

  @@unique([storefrontId, sku])
  @@index([storefrontId])
  @@index([needsReview])
  @@index([storefrontId, needsReview])
  @@map("product_masters")
}

/// GrabOrder stores raw Grab orders and their financial breakdowns.
model GrabOrder {
  id                   String            @id @default(uuid()) @db.Uuid
  storefrontId         String            @map("storefront_id") @db.Uuid
  storefront           Storefront        @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  grabOrderId          String            @unique @map("grab_order_id")
  grabEmail            String            @map("grab_email")
  orderDate            DateTime          @map("order_date")
  rawSubtotal          Decimal           @map("raw_subtotal") @db.Decimal(12, 2)
  rawDeliveryFee       Decimal           @default(0.00) @map("raw_delivery_fee") @db.Decimal(12, 2)
  rawTax               Decimal           @default(0.00) @map("raw_tax") @db.Decimal(12, 2)
  rawGrabCommission    Decimal           @default(0.00) @map("raw_grab_commission") @db.Decimal(12, 2)
  totalCollectedByGrab Decimal           @map("total_collected_by_grab") @db.Decimal(12, 2)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  orderLineItems       OrderLineItem[]
  reconciliationLog    ReconciliationLog?

  @@index([storefrontId])
  @@index([orderDate])
  @@index([storefrontId, orderDate])
  @@map("grab_orders")
}

/// OrderLineItem captures individual foods sold and captures unit prices at the time of sale.
model OrderLineItem {
  id                              String        @id @default(uuid()) @db.Uuid
  grabOrderId                     String        @map("grab_order_id") @db.Uuid
  grabOrder                       GrabOrder     @relation(fields: [grabOrderId], references: [id], onDelete: Cascade)
  productMasterId                 String        @map("product_master_id") @db.Uuid
  productMaster                   ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Restrict)
  quantity                        Int
  grabUnitPriceCharged            Decimal       @map("grab_unit_price_charged") @db.Decimal(12, 2)
  restaurantUnitPriceAtTimeOfSale Decimal       @map("restaurant_unit_price_at_time_of_sale") @db.Decimal(12, 2)
  createdAt                       DateTime      @default(now()) @map("created_at")
  updatedAt                       DateTime      @updatedAt @map("updated_at")

  @@index([grabOrderId])
  @@index([productMasterId])
  @@map("order_line_items")
}

/// ReconciliationLog tracks calculated margins, payout totals, and status.
model ReconciliationLog {
  id                  String               @id @default(uuid()) @db.Uuid
  grabOrderId         String               @unique @map("grab_order_id") @db.Uuid
  grabOrder           GrabOrder            @relation(fields: [grabOrderId], references: [id], onDelete: Cascade)
  totalGrabAmount     Decimal              @map("total_grab_amount") @db.Decimal(12, 2)
  totalMerchantPayout Decimal              @map("total_merchant_payout") @db.Decimal(12, 2)
  clientGrossProfit   Decimal              @map("client_gross_profit") @db.Decimal(12, 2)
  adjustmentAmount    Decimal              @default(0.00) @map("adjustment_amount") @db.Decimal(12, 2)
  adjustmentNote      String?              @map("adjustment_note")
  status              ReconciliationStatus @default(PENDING)
  invoiceId           String?              @map("invoice_id") @db.Uuid
  invoice             Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([invoiceId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("reconciliation_logs")
}

enum ReconciliationStatus {
  PENDING
  RECONCILED
  INVOICED
  PAID
}

/// Invoice tracks statements generated for local sellers.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  merchantId    String        @map("merchant_id") @db.Uuid
  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique @map("invoice_number")
  pdfPath       String?       @map("pdf_path")
  billingDate   DateTime      @map("billing_date")
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  reconciliationLogs ReconciliationLog[]

  @@index([merchantId])
  @@index([status])
  @@index([billingDate])
  @@index([merchantId, billingDate])
  @@index([status, billingDate])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOIDED
}

/// MerchantChecklist stores submissions of the Merchant Recruitment & Registration Checklist.
model MerchantChecklist {
  id                 String   @id @default(uuid()) @db.Uuid
  agentName          String   @map("agent_name")
  date               DateTime @map("date")
  merchant           String   @map("merchant")
  personInCharge     String   @map("person_in_charge")
  mobileNumber       String   @map("mobile_number")
  emailAddress       String   @map("email_address")
  outletAddress      String   @map("outlet_address")
  numberOfOutlets    Int      @default(1) @map("number_of_outlets")
  businessType       String   @map("business_type")
  targetPlatform     String   @map("target_platform")
  leadStatus         String   @map("lead_status")
  language           String   @default("EN")

  agentSelfCheck     String   @map("agent_self_check") @db.Text
  agentNotes         String?  @map("agent_notes") @db.Text

  qualificationCheck String   @map("qualification_check") @db.Text
  yesScore           Int      @default(0) @map("yes_score")
  noScore            Int      @default(0) @map("no_score")
  naScore            Int      @default(0) @map("na_score")
  totalChecked       Int      @default(0) @map("total_checked")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([emailAddress])
  @@index([createdAt])
  @@map("merchant_checklists")
}

/// BusinessRegistration stores official Merchant Registration forms (Borang Peniaga).
model BusinessRegistration {
  id             String    @id @default(uuid()) @db.Uuid
  date           DateTime? @map("date")
  memberNo       String?   @map("member_no")

  // 1. Maklumat Peniaga
  fullName       String?   @map("full_name")
  mailingAddress String?   @map("mailing_address") @db.Text
  storeAddress   String    @map("store_address") @db.Text
  businessName   String    @map("business_name")
  registrationNo String?   @map("registration_no")
  icPassportNo   String?   @map("ic_passport_no")
  dateOfBirth    String?   @map("date_of_birth")
  age            String?   @map("age")
  religion       String?   @map("religion")
  race           String?   @map("race")
  nationality    String?   @map("nationality")
  contactNumber  String    @map("contact_number")
  emailAddress   String    @map("email_address")
  gender         String?   @map("gender")

  // Fields maintained for backwards compatibility
  personInCharge String?   @map("person_in_charge")
  typeOfFood     String?   @map("type_of_food")

  // 2. Maklumat Operasi
  operatingDays  String?   @map("operating_days") @db.Text
  operatingHours String?   @map("operating_hours")

  // 3. Maklumat Akaun Bank
  bankName          String? @map("bank_name")
  bankAccountName   String? @map("bank_account_name")
  bankAccountNumber String? @map("bank_account_number")

  // 4. Senarai Semak Dokumen
  documentsChecklist String? @map("documents_checklist") @db.Text
  shopPhotoUrl       String? @map("shop_photo_url") @db.Text

  // 5. Bahagian Kegunaan Pejabat/Ejen
  receivedDate      DateTime? @map("received_date")
  processingOfficer String?   @map("processing_officer")
  status            String?   @default("Dalam Proses") @map("status")
  rejectionReason   String?   @map("rejection_reason") @db.Text
  activationDate    DateTime? @map("activation_date")

  // 6. Penafian & Terma Perkhidmatan
  agreedToTerms Boolean @default(true) @map("agreed_to_terms")

  // 7. Pengesahan & Tandatangan
  merchantSignature     String?   @map("merchant_signature") @db.Text
  merchantSignatureName String?   @map("merchant_signature_name")
  merchantSignatureIc   String?   @map("merchant_signature_ic")
  merchantSignatureDate DateTime? @map("merchant_signature_date")

  agentSignature     String?   @map("agent_signature") @db.Text
  agentSignatureName String?   @map("agent_signature_name")
  agentSignatureId   String?   @map("agent_signature_id")
  agentSignatureDate DateTime? @map("agent_signature_date")

  reviewerSignature String?   @map("reviewer_signature") @db.Text
  reviewerName      String?   @map("reviewer_name")
  reviewerRole      String?   @map("reviewer_role")
  reviewerDate      DateTime? @map("reviewer_date")

  approverSignature String?   @map("approver_signature") @db.Text
  approverName      String?   @map("approver_name")
  approverRole      String?   @map("approver_role")
  approverDate      DateTime? @map("approver_date")

  language  String   @default("EN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([emailAddress])
  @@index([createdAt])
  @@map("business_registrations")
}

/// AgentRegistration stores official Agent Recruitment & Merchant Registration Audit forms (Borang Ejen).
model AgentRegistration {
  id                      String    @id @default(uuid()) @db.Uuid
  date                    DateTime  @map("date")
  agentNo                 String    @map("agent_no")
  agentName               String    @map("agent_name")
  icNumber                String    @map("ic_number")
  race                    String    @map("race")
  religion                String    @map("religion")
  address                 String    @map("address") @db.Text
  phoneNumber             String    @map("phone_number")

  bankAccountName         String    @map("bank_account_name")
  bankName                String    @map("bank_name")
  bankAccountNumber       String    @map("bank_account_number")

  registeredMerchants     String    @map("registered_merchants") @db.Text

  prospectSource          String    @map("prospect_source")
  prospectSourceOther     String?   @map("prospect_source_other")
  approachedByOtherAgents String    @map("approached_by_other_agents")
  confidenceLevel         String    @map("confidence_level")
  estimatedDuration       String    @map("estimated_duration")

  agentSignature          String?   @map("agent_signature") @db.Text
  agentSignatureDate      DateTime  @default(now()) @map("agent_signature_date")

  supervisorSignature     String?   @map("supervisor_signature") @db.Text
  supervisorName          String?   @map("supervisor_name")
  supervisorDate          DateTime? @map("supervisor_date")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([agentNo])
  @@index([icNumber])
  @@index([createdAt])
  @@map("agent_registrations")
}

/// User represents administrative, management, and operational staff with RBAC.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  email        String?   @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  department   String?   @default("Operations") @map("department")
  position     String?   @default("Staff Member") @map("position")
  permissions  String?   @default("[\"dashboard:view\",\"forms:submit\"]") @map("permissions") @db.Text
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([username])
  @@index([department])
  @@index([role])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  STAFF
  AGENT
}

